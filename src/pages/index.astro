---
import { getCollection } from 'astro:content';
import ProfilePage from '../components/ProfilePage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const profiles = await getCollection('profile');
const profile = profiles.find((entry) => entry.data.locale === 'es');

if (!profile) {
	throw new Error('Spanish profile content is missing.');
}
---

<BaseLayout
	title={`${profile.data.name} | Desarrollador Front End`}
	description={profile.data.bio}
>
	<ProfilePage profile={profile.data} locale="es" />
</BaseLayout>
