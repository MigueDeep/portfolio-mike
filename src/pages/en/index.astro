---
import { getCollection } from 'astro:content';
import ProfilePage from '../../components/ProfilePage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const profiles = await getCollection('profile');
const profile = profiles.find((entry) => entry.data.locale === 'en');

if (!profile) {
	throw new Error('English profile content is missing.');
}
---

<BaseLayout
	locale="en"
	title={`${profile.data.name} | Front-End Developer`}
	description={profile.data.bio}
>
	<ProfilePage profile={profile.data} locale="en" />
</BaseLayout>
