---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/ui';

interface Props {
	project: CollectionEntry<'projects'>;
	locale: Locale;
}

const { project, locale } = Astro.props;
const slug = project.id.replace(/-(es|en)$/, '');
const projectPath = locale === 'es' ? `/projects/${slug}/` : `/en/projects/${slug}/`;
---

<article class="project-card">
	<div class="project-card-index" aria-hidden="true">01</div>
	<div class="project-card-content">
		{project.data.company && <p class="project-company">{project.data.company}</p>}
		<p class="eyebrow">{project.data.stack.join(' / ')}</p>
		<h2>{project.data.title}</h2>
		<p>{project.data.summary}</p>
		<!-- <p>{project.data.description}</p> -->
		{project.data.type === 'work' && <div class="project-work-details">
			<div>
				<p class="project-detail-label">{locale === 'es' ? 'Stack' : 'Stack'}</p>
				<div class="project-stack-tags">
					{project.data.stack.map((technology) => <span>{technology}</span>)}
				</div>
			</div>
			<div>
				<p class="project-detail-label">{locale === 'es' ? 'Features' : 'Features'}</p>
				<ul class="project-feature-list">
					{project.data.features.map((feature) => <li>{feature}</li>)}
				</ul>
			</div>
		</div>}
		{project.data.type === 'personal' ? (
			<a class="text-link" href={projectPath}>
				{locale === 'es' ? 'Ver detalle' : 'View case study'}
				<span aria-hidden="true">↗</span>
			</a>
		) : (
			<span class="project-kind">{locale === 'es' ? 'Proyecto profesional' : 'Professional project'}</span>
		)}
	</div>
	<div class="project-card-arrow" aria-hidden="true">↗</div>
</article>
