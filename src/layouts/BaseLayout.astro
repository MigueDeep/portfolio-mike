---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import type { Locale } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	locale?: Locale;
	image?: string;
}

const { title, description, locale = 'es', image } = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/svg+xml" href="/dev.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0f172a" />
		<link rel="canonical" href={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content={locale === 'es' ? 'es_MX' : 'en_US'} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{image && <meta property="og:image" content={new URL(image, Astro.url).href} />}
		{image && <meta name="twitter:image" content={new URL(image, Astro.url).href} />}
		<title>{title}</title>
		<script is:inline>
			const themeKey = 'portfolio-theme';

			function applyTheme() {
				const theme = localStorage.getItem(themeKey) || 'dark';
				document.documentElement.dataset.theme = theme;

				const toggle = document.querySelector('.theme-control input');
				if (toggle) toggle.checked = theme === 'light';
			}

			document.addEventListener('change', (event) => {
				const toggle = event.target.closest('.theme-control input');
				if (!toggle) return;

				const theme = toggle.checked ? 'light' : 'dark';
				localStorage.setItem(themeKey, theme);
				document.documentElement.dataset.theme = theme;
			});

			document.addEventListener('astro:page-load', applyTheme);
			applyTheme();
		</script>
		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>
